{
  // Deploy: npx wrangler deploy --config worker/wrangler.jsonc
  // Secrets: npx wrangler secret put GITHUB_APP_ID | GITHUB_PRIVATE_KEY_B64 | GITHUB_WEBHOOK_SECRET
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gatekeeper",
  "main": "index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  "vars": {
    // Both safeties default ON. You turn them off deliberately, per environment.
    "DRY_RUN": "false",
    "AUTOMERGE_ENABLED": "false",
    // Must match the App's slug, or the self-sender loop-breaker will not fire.
    // Do NOT filter all bots: agent-authored PRs are exactly what this routes.
    "APP_SLUG": "gatekeeper-a64397",
    // Empty means every installed repo. Set it while you are still testing.
    "ALLOWED_REPOS": "owizdom/gatekeeper-testbed",
    // Window: debounce from the LAST sibling, hard cap from the FIRST so a batch
    // always closes, plus a grace period in which a straggler may reopen it.
    "BATCH_IDLE_MS": "45000",
    "BATCH_CAP_MS": "150000",
    "BATCH_GRACE_MS": "300000"
  },

  "durable_objects": {
    "bindings": [{ "name": "BATCH", "class_name": "BatchDO" }]
  },
  "migrations": [
    {
      "tag": "v1",
      // 🛑 Free-plan Durable Objects are SQLite-backed ONLY. The key is
      // new_sqlite_classes; new_classes fails at deploy time.
      "new_sqlite_classes": ["BatchDO"]
    }
  ]

}
