{
  "name": "gatekeeper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A policy layer for agent-authored pull requests. Auto-merge, escalate, batch, refuse.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test 'test/**/*.test.ts'",
    "route": "node bin/gk.ts route",
    "smoke": "node smoke/smoke-approvals.mjs",
    "setup": "node bin/gk-app-setup.mjs",
    "deploy": "wrangler deploy --config worker/wrangler.jsonc",
    "deploy:check": "wrangler deploy --config worker/wrangler.jsonc --dry-run"
  },
  "dependencies": {
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "wrangler": "^4.129.1"
  }
}
